# Super Cleaning Bros — copy to .env and fill in. Never commit .env.

# Local office app
PORT=8787
DATABASE_PATH=./data/scb.sqlite
PUBLIC_BASE_URL=http://localhost:8787

# Shop origin for the travel-fee rule. Defaults are Erie, CO 80516.
SHOP_POSTAL_CODE=80516
SHOP_LAT=40.0503
SHOP_LNG=-105.0497
TRAVEL_THRESHOLD_MINUTES=30
TRAVEL_FEE_CENTS=10000

# Set both before exposing the app beyond your own computer.
# OFFICE_PASSWORD is the office sign-in. SESSION_SECRET signs the cookie (16+ characters).
OFFICE_PASSWORD=
SESSION_SECRET=

# Optional. When set, drive time uses Google Distance Matrix and falls back
# to the offline estimate if Google is unavailable.
GOOGLE_MAPS_API_KEY=

# GoHighLevel API v2 private integration. Leave blank to run without CRM sync.
# Create the token in GHL: Settings → Private Integrations.
# Scopes: contacts read/write, opportunities read/write,
# conversations read/write, conversations/message.write.
# Calendars/events read is optional.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Required to accept inbound webhooks. Send this value in X-SCB-Webhook-Secret.
GHL_WEBHOOK_SECRET=
# Optional user id included on contact notes when GHL requires it.
GHL_USER_ID=
# Pipeline stage ids used when a job, invoice, or payment is pushed back.
GHL_STAGE_SCHEDULED=
GHL_STAGE_IN_PROGRESS=
GHL_STAGE_DONE=
GHL_STAGE_INVOICED=
GHL_STAGE_PAID=
# Optional opportunity stage when a tech taps On my way. Leave blank to keep the current stage.
GHL_STAGE_ON_MY_WAY=
# Authorized location email. Required before GoHighLevel can email a photo link or fall back from SMS.
GHL_EMAIL_FROM=
# Public review link. Finish sends it through GoHighLevel only when this is set.
REVIEW_URL=
# Optional GHL custom field id. The photo page URL is written here after the photo email sends.
GHL_PHOTO_LINK_FIELD_ID=

# Live lifecycle check. Use Majdi's own GoHighLevel contact, never a customer.
# See docs/ghl-lifecycle.md. The script refuses to run until the confirm value matches.
GHL_E2E_CONFIRM=
GHL_E2E_PORT=8799
GHL_TEST_CONTACT_ID=
GHL_TEST_CONTACT_FIRST=
GHL_TEST_CONTACT_LAST=
GHL_TEST_CONTACT_PHONE=
GHL_TEST_CONTACT_EMAIL=

# Stripe. Leave blank to record payments locally without charging a card.
# Card numbers are never stored here — only Stripe customer and payment-method ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
